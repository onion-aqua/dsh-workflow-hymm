{
  "name": "dsh-visual-workflow",
  "version": "0.18.0",
  "description": "Visual task workflows for DeepSeek Harness 0.2.1-rc.3",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/host/service.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/service.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./types": {
      "types": "./lib/types/shared/model.d.ts",
      "default": "./lib/shared.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "pack:plugin": "npm pack --pack-destination ../../outputs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-skill": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@playwright/test": "1.58.2",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.10.1",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "marked": "17.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
